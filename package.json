{
  "name": "spotterjn",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "android:sync": "npm run build && cap sync android",
    "android:open": "node ./scripts/android.mjs open",
    "android:run": "node ./scripts/android.mjs run",
    "android:live": "node ./scripts/android.mjs run --live-reload --host 10.0.2.2 --port 5173"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "@capacitor/preferences": "^7.0.4",
    "@ionic/react": "^8.0.0",
    "@ionic/react-router": "^8.8.8",
    "@supabase/supabase-js": "^2.117.3",
    "@types/react-router-dom": "^5.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^5.3.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "@testing-library/jest-dom": "^6.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^30.1.2",
    "typescript": "^5.6.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  }
